# ============================================
# Nuxt Admin Template - 环境变量配置
# 复制此文件为 .env 并根据实际情况修改
# ============================================

# 数据库连接字符串（必填）
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 本地开发示例：postgresql://postgres:postgres@localhost:5432/nuxt_admin
# Neon 示例：postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nuxt_admin

# JWT 密钥（必填，请使用随机字符串）
# 生成方式：openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# Redis 连接（可选，用于缓存和会话管理）
# 不配置时系统可正常运行，但会跳过缓存
REDIS_URL=

# 运行环境
NODE_ENV=development

# ============================================
# 以下为可选配置
# ============================================

# 部署平台（留空使用默认 node-server）
# 可选值：vercel / netlify / node-server
NITRO_PRESET=

# 调试 SQL 查询（开发环境）
DEBUG_SQL=false
