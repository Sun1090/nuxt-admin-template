{
  "name": "nuxt-admin-template",
  "type": "module",
  "version": "1.0.0",
  "description": "Nuxt Admin Template - a clean reusable admin dashboard built with Nuxt, Drizzle ORM, shadcn-vue, and TailwindCSS",
  "author": "",
  "license": "MIT",
  "homepage": "",
  "repository": {},
  "keywords": [
    "dashboard",
    "admin-dashboard",
    "vue",
    "nuxt",
    "shadcn-vue",
    "shadcn-nuxt",
    "shadcn-dashboard",
    "tailwindcss",
    "drizzle",
    "rbac",
    "template"
  ],
  "main": "./nuxt.config.ts",
  "files": [
    "app.vue",
    "components",
    "components.json",
    "composables",
    "constants",
    "layouts",
    "lib",
    "nuxt.config.ts",
    "pages",
    "types"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "db:migrate": "npx drizzle-kit migrate",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push --force",
    "db:studio": "npx drizzle-kit studio",
    "db:drop": "npx drizzle-kit drop",
    "db:check": "npx drizzle-kit check",
    "clear-db": "cd scripts && npx tsx clear-database.js",
    "create-admin": "cd scripts && npx tsx create-admin.js",
    "db:init": "cd scripts && node init-system.js",
    "admin:create": "node scripts/create-admin.js",
    "setup:full": "npm run db:init && npm run admin:create",
    "setup:check": "node scripts/check-system-init.js",
    "setup": "npm install && npm run db:migrate",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "eslint --fix ."
  },
  "dependencies": {
    "@dicebear/collection": "^9.2.4",
    "@dicebear/core": "^9.2.4",
    "@iconify-json/lucide": "^1.2.72",
    "@iconify-json/radix-icons": "^1.2.5",
    "@internationalized/date": "^3.10.0",
    "@number-flow/vue": "^0.4.8",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.6.1",
    "@unovis/vue": "^1.6.1",
    "bcrypt": "^6.0.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "echarts": "6.0.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-vue": "^8.6.0",
    "formidable": "^3.5.4",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.12.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.7",
    "prompts": "^2.4.2",
    "redis": "^5.9.0",
    "reka-ui": "^2.6.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.15.6",
    "@antfu/eslint-config": "^4.19.0",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "^1.15.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^0.5.5",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^12.8.2",
    "@vueuse/math": "^12.8.2",
    "@vueuse/nuxt": "^12.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "lucide-vue-next": "^0.482.0",
    "nuxt": "^4.2.1",
    "shadcn-nuxt": "^2.3.2",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.9.3",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^2.2.12"
  }
}
